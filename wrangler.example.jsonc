{
  "name": "tibo-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "DISCORD_PUBLIC_KEY": "YOUR_64_HEX_DISCORD_PUBLIC_KEY",
    "DISCORD_APPLICATION_ID": "YOUR_DISCORD_APPLICATION_ID",
    "DISCORD_TEST_GUILD_ID": "YOUR_DISCORD_GUILD_ID",
    "DISCORD_TEST_CHANNEL_ID": "YOUR_DISCORD_CHANNEL_ID",
    "NITTER_BASE_URL": "https://x.noodl3.net",
    "DISCORD_NOTIFY_CHANNEL_ID": "YOUR_DISCORD_CHANNEL_ID",
    "WATCH_ENABLED": "false",
    "SITE_RESETS_ENABLED": "false",
    "RESET_ANALYSIS_DAILY_LIMIT": "100",
    "GATEWAY_ENABLED": "false",
    "RESET_CHAT_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tibo-bot-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROBE_JOBS",
        "queue": "tibo-bot-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "tibo-bot-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY",
        "class_name": "DiscordGateway"
      },
      {
        "name": "COMMAND_GUARD",
        "class_name": "DiscordCommandGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-gateway",
      "new_sqlite_classes": [
        "DiscordGateway"
      ]
    },
    {
      "tag": "v2-command-guard",
      "new_sqlite_classes": [
        "DiscordCommandGuard"
      ]
    }
  ]
}
